# Fake but well-formed Scaleway credentials for the emulator.
#
# The emulator never validates them, but the SDK and the CLI validate their FORMAT: the access key
# must match SCW[A-Z0-9]{17} and the secret key must be a UUID. These values are deliberately
# public placeholders (all ones), they open nothing.
#
# Usage: set -a; . tools/conformance/scaleway/fake-credentials.env; set +a
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=11111111-1111-1111-1111-111111111111
# The project and the organization are deliberately different UUIDs, because
# they are on a real account: infrastructure belongs to a project, IAM and
# billing belong to the organization above it. Using one value for both makes
# the suite pass over a confusion instead of catching it.
SCW_DEFAULT_PROJECT_ID=11111111-1111-1111-1111-111111111111
SCW_DEFAULT_ORGANIZATION_ID=99999999-9999-4999-8999-999999999999
SCW_DEFAULT_ZONE=fr-par-1
SCW_DEFAULT_REGION=fr-par
SCW_API_URL=http://127.0.0.1:4599
SCW_INSECURE=true
