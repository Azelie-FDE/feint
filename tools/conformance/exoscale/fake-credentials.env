# Fake but well-formed Exoscale credentials for the emulator.
#
# The emulator never validates them. The CLI does check their shape before it
# signs anything: the key is EXO followed by base62, the secret is 40 characters.
#
# These values are deliberately public placeholders, they open nothing.
#
# Usage: set -a; . tools/conformance/exoscale/fake-credentials.env; set +a
EXOSCALE_API_KEY=EXOxxxxxxxxxxxxxxxxxxxx
EXOSCALE_API_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EXOSCALE_ZONE=ch-dk-2
